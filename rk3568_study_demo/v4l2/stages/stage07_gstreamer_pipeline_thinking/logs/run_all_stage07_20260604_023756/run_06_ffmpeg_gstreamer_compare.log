exit_code                      : 0
elapsed_ms                     : 133
output_begin
output_end

[ffmpeg run]
command                        : ffmpeg -hide_banner -loglevel error -f lavfi -i testsrc2=size=320x240:rate=30 -frames:v 12 -f null -
exit_code                      : 0
elapsed_ms                     : 155
